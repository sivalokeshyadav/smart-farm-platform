# Smart Farmer Platform — Backend Environment Template (.env.example)
PROJECT_NAME="Smart Farmer Platform - Kurnool Pilot"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB Connection Parameters
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=smart_farmer_pilot

# Optional Full Connection URI override (leave blank to use MONGO_HOST/PORT/DB)
# MONGODB_URL=mongodb://localhost:27017/smart_farmer_pilot

# Pilot Regional Constants
DEFAULT_DISTRICT="Kurnool"
DEFAULT_STATE="Andhra Pradesh"

# Rate Limiting & Security
MAX_LOGIN_ATTEMPTS=5
OTP_EXPIRY_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# Service Adapter Modes (Options: SIMULATOR / MOCK / LIVE)
IVR_MODE="SIMULATOR"
SMS_MODE="MOCK"
PAYMENT_MODE="SANDBOX"
AI_CROP_MODE="MOCK"
WEATHER_MODE="MOCK"
MARKET_PRICE_MODE="MOCK"
